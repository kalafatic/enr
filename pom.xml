<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ai.enr</groupId>
  <artifactId>enr-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>EVO Native Runtime (ENR)</name>
  <description>Native AI Model Inference &amp; Orchestration Engine</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <junit.version>5.10.2</junit.version>
    <enr.version>1.0.0-SNAPSHOT</enr.version>
  </properties>

  <modules>
    <module>enr-core</module>
    <module>enr-model-loader</module>
    <module>enr-tokenizer</module>
    <module>enr-compute</module>
    <module>enr-compute-cpu</module>
    <module>enr-compute-cuda</module>
    <module>enr-inference</module>
    <module>enr-runtime</module>
    <module>enr-server</module>
    <module>enr-java-api</module>
    <module>enr-cli</module>
    <module>enr-tests</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>ai.enr</groupId>
        <artifactId>enr-core</artifactId>
        <version>${enr.version}</version>
      </dependency>
      <dependency>
        <groupId>ai.enr</groupId>
        <artifactId>enr-model-loader</artifactId>
        <version>${enr.version}</version>
      </dependency>
      <dependency>
        <groupId>ai.enr</groupId>
        <artifactId>enr-tokenizer</artifactId>
        <version>${enr.version}</version>
      </dependency>
      <dependency>
        <groupId>ai.enr</groupId>
        <artifactId>enr-compute</artifactId>
        <version>${enr.version}</version>
      </dependency>
      <dependency>
        <groupId>ai.enr</groupId>
        <artifactId>enr-compute-cpu</artifactId>
        <version>${enr.version}</version>
      </dependency>
      <dependency>
        <groupId>ai.enr</groupId>
        <artifactId>enr-compute-cuda</artifactId>
        <version>${enr.version}</version>
      </dependency>
      <dependency>
        <groupId>ai.enr</groupId>
        <artifactId>enr-inference</artifactId>
        <version>${enr.version}</version>
      </dependency>
      <dependency>
        <groupId>ai.enr</groupId>
        <artifactId>enr-runtime</artifactId>
        <version>${enr.version}</version>
      </dependency>
      <dependency>
        <groupId>ai.enr</groupId>
        <artifactId>enr-server</artifactId>
        <version>${enr.version}</version>
      </dependency>
      <dependency>
        <groupId>ai.enr</groupId>
        <artifactId>enr-java-api</artifactId>
        <version>${enr.version}</version>
      </dependency>
      <dependency>
        <groupId>ai.enr</groupId>
        <artifactId>enr-cli</artifactId>
        <version>${enr.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>21</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
          <configuration>
            <useModulePath>false</useModulePath>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
